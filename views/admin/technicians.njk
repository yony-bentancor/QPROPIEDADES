{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">PROVEEDORES</span><h1>Técnicos / Empresas</h1><p class="muted">El administrador carga y gestiona proveedores; no tienen usuario por ahora.</p></div><a href="/admin/tecnicos/nuevo" class="btn btn-primary">+ Nuevo técnico</a></div><div class="cards-list">{% for t in technicians %}<article class="provider-card"><div>{% if t.active %}<span class="badge badge-ok">Activo</span>{% else %}<span class="badge badge-muted">Inactivo</span>{% endif %}<h2>{{ t.companyName }}</h2><p><strong>{{ t.contactName }}</strong> · {{ t.phone }}</p><p>{{ t.email }}</p><p class="muted">RUT {{ t.rut }} · {{ t.address }}</p><p><strong>Especialidades:</strong> {{ t.specialties | join(', ') }}</p><p><strong>Zonas:</strong> {{ t.zones | join(', ') }}</p></div><div class="actions vertical"><a class="btn btn-dark" href="/admin/tecnicos/{{ t.id }}/editar">Editar</a><form method="post" action="/admin/tecnicos/{{ t.id }}/eliminar" onsubmit="return confirm('¿Eliminar proveedor?')"><button class="btn btn-danger">Eliminar</button></form></div></article>{% endfor %}</div>{% endblock %}
