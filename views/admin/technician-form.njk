{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">PROVEEDOR</span><h1>{% if mode == 'create' %}Nuevo técnico / empresa{% else %}Editar técnico / empresa{% endif %}</h1></div></div><form method="post" action="{% if mode == 'create' %}/admin/tecnicos/nuevo{% else %}/admin/tecnicos/{{ technician.id }}/editar{% endif %}" class="panel mega-form"><div class="form-grid"><label>Empresa<input name="companyName" value="{{ technician.companyName }}" required></label><label>Contacto<input name="contactName" value="{{ technician.contactName }}" required></label><label>Teléfono<input name="phone" value="{{ technician.phone }}"></label><label>WhatsApp (solo números)<input name="whatsapp" value="{{ technician.whatsapp }}" placeholder="59899..."></label><label>Email<input type="email" name="email" value="{{ technician.email }}"></label><label>RUT<input name="rut" value="{{ technician.rut }}"></label><label class="full">Dirección<input name="address" value="{{ technician.address }}"></label><label class="full">Especialidades, separadas por coma<input name="specialties" value="{{ technician.specialties | join(', ') }}"></label><label class="full">Zonas, separadas por coma<input name="zones" value="{{ technician.zones | join(', ') }}"></label><label>Activo<select name="active"><option value="true" {% if technician.active != false %}selected{% endif %}>Sí</option><option value="false" {% if technician.active == false %}selected{% endif %}>No</option></select></label><label class="full">Notas<textarea name="notes" rows="4">{{ technician.notes }}</textarea></label></div><div class="form-actions"><a href="/admin/tecnicos" class="btn btn-light">Cancelar</a><button class="btn btn-primary">Guardar</button></div></form>{% endblock %}
