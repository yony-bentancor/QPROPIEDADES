{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">RECLAMO #{{ complaint.number }}</span><h1>{{ complaint.title }}</h1><p class="muted">{{ complaint.category }} · {{ complaint.status }}</p></div>{% if whatsappUrl %}<a href="{{ whatsappUrl }}" target="_blank" class="btn btn-whatsapp">Enviar por WhatsApp</a>{% endif %}</div><div class="two-col"><section class="panel"><h2>Problema</h2><p>{{ complaint.description }}</p><div class="detail-grid"><div><span>Prioridad</span><strong>{{ complaint.priority }}</strong></div><div><span>Estado</span><strong>{{ complaint.status }}</strong></div><div><span>Creado</span><strong>{{ complaint.createdAt }}</strong></div><div><span>Categoría</span><strong>{{ complaint.category }}</strong></div></div><h3>Fotos / videos</h3><div class="media-grid">{% for a in complaint.attachments %}{% if a.kind == 'video' %}<video src="{{ a.url }}" controls></video>{% else %}<img src="{{ a.url }}" alt="{{ a.name }}">{% endif %}{% else %}<p class="muted">Sin archivos.</p>{% endfor %}</div></section><section class="panel"><h2>Propiedad e inquilino</h2><p><strong>{{ property.address }}{% if property.unit %} · {{ property.unit }}{% endif %}</strong></p><a href="{{ property.mapUrl }}" target="_blank">Abrir Google Maps ↗</a><hr><p><strong>{{ property.tenant.name }}</strong></p><p>{{ property.tenant.phone }} · {{ property.tenant.email }}</p><a href="/admin/propiedades/{{ property.code }}">Abrir ficha de propiedad</a></section></div><section class="panel"><h2>Asignar técnico / empresa</h2><form method="post" action="/admin/reclamos/{{ complaint.number }}/asignar" class="inline-form"><select name="technicianId" required><option value="">Seleccionar...</option>{% for t in technicians %}<option value="{{ t.id }}" {% if complaint.technicianId == t.id %}selected{% endif %}>{{ t.companyName }} · {{ t.contactName }} · {{ t.specialties | join(', ') }}</option>{% endfor %}</select><button class="btn btn-primary">Asignar</button></form>{% if technician %}<div class="assignment-box"><strong>{{ technician.companyName }}</strong><span>{{ technician.contactName }} · {{ technician.phone }}</span><span>{{ technician.specialties | join(', ') }}</span>{% if whatsappUrl %}<a href="{{ whatsappUrl }}" target="_blank" class="btn btn-whatsapp">🟢 Enviar trabajo completo por WhatsApp</a>{% endif %}</div>{% endif %}</section><section class="panel"><h2>Estado</h2><form method="post" action="/admin/reclamos/{{ complaint.number }}/estado" class="inline-form"><select name="status">{% for s in statuses %}<option value="{{ s }}" {% if complaint.status == s %}selected{% endif %}>{{ s }}</option>{% endfor %}</select><button class="btn btn-dark">Actualizar estado</button></form></section><section class="panel"><h2>Historial</h2><div class="timeline">{% for h in complaint.history %}<div><span>{{ h.at }}</span><strong>{{ h.status }}</strong><p>{{ h.note }}</p></div>{% endfor %}</div></section><section class="panel"><h2>Ficha pública para proveedor</h2><p>Enlace con token aleatorio, sin login.</p><a href="/trabajo/{{ complaint.shareToken }}" target="_blank" class="btn btn-light">Abrir ficha compartible</a></section>{% endblock %}
