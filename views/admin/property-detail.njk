{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">{{ property.code }} · {{ property.type }}</span><h1>{{ property.address }}{% if property.unit %} · {{ property.unit }}{% endif %}</h1><p class="muted">{{ property.neighborhood }} · Padrón {{ property.cadastralNumber }}</p></div><div class="actions"><a href="{{ property.mapUrl }}" target="_blank" class="btn btn-light">Google Maps ↗</a><a href="/admin/propiedades/{{ property.code }}/editar" class="btn btn-dark">Editar</a></div></div>
<div class="property-hero"><img src="{{ property.coverPhoto }}" alt="Fachada"><div><span class="badge badge-ok">{{ property.status }}</span><h2>Ficha digital de la propiedad</h2><p>{{ property.notes }}</p></div><div class="qr-card"><img src="{{ qr }}" alt="QR"><strong>{{ property.code }}</strong><a href="{{ property.qrPublicPath }}" target="_blank">Abrir QR público</a></div></div>
<div class="tabs"><a href="#informacion">Información</a><a href="#ubicacion">Ubicación</a><a href="#fotos">Fotos</a><a href="#propietario">Propietario</a><a href="#inquilino">Inquilino</a><a href="#alquiler">Alquiler</a><a href="#impuestos">Impuestos</a><a href="#documentos">Documentos</a><a href="#reparaciones">Reparaciones</a><a href="#alertas">Alertas</a><a href="#historial">Historial</a><a href="#qr">QR</a></div>
<section class="panel" id="informacion"><h2>Información</h2><div class="detail-grid"><div><span>Tipo</span><strong>{{ property.type }}</strong></div><div><span>Padrón</span><strong>{{ property.cadastralNumber }}</strong></div><div><span>Dormitorios</span><strong>{{ property.bedrooms }}</strong></div><div><span>Baños</span><strong>{{ property.bathrooms }}</strong></div><div><span>Área</span><strong>{{ property.builtArea }} m²</strong></div><div><span>Año</span><strong>{{ property.yearBuilt }}</strong></div></div></section>
<section class="panel" id="ubicacion"><h2>Ubicación</h2><div class="detail-grid"><div><span>Dirección</span><strong>{{ property.address }}</strong></div><div><span>Barrio</span><strong>{{ property.neighborhood }}</strong></div><div><span>Ciudad</span><strong>{{ property.city }}</strong></div><div><span>Coordenadas</span><strong>{{ property.latitude }}, {{ property.longitude }}</strong></div></div><a href="{{ property.mapUrl }}" target="_blank" class="btn btn-light">Abrir Google Maps</a></section>
<section class="panel" id="fotos"><h2>Fotos</h2><div class="media-grid">{% for photo in property.photos %}<img src="{{ photo.url }}" alt="{{ photo.label }}">{% else %}<p class="muted">Sin fotos.</p>{% endfor %}</div></section>
<section class="panel" id="propietario"><h2>Propietario</h2><div class="detail-grid"><div><span>Nombre</span><strong>{{ property.owner.name }}</strong></div><div><span>Documento</span><strong>{{ property.owner.document }}</strong></div><div><span>Teléfono</span><strong>{{ property.owner.phone }}</strong></div><div><span>Email</span><strong>{{ property.owner.email }}</strong></div><div class="wide"><span>Dirección</span><strong>{{ property.owner.address }}</strong></div></div></section>
<section class="panel" id="inquilino"><h2>Inquilino</h2><div class="detail-grid"><div><span>Nombre</span><strong>{{ property.tenant.name }}</strong></div><div><span>Documento / RUT</span><strong>{{ property.tenant.document }}</strong></div><div><span>Teléfono</span><strong>{{ property.tenant.phone }}</strong></div><div><span>Email</span><strong>{{ property.tenant.email }}</strong></div><div class="wide"><span>Emergencia</span><strong>{{ property.tenant.emergencyContact }}</strong></div></div></section>
<section class="panel" id="alquiler"><h2>Alquiler</h2><div class="detail-grid"><div><span>Importe</span><strong>{{ money(property.lease.amount,property.lease.currency) }}</strong></div><div><span>Día pago</span><strong>{{ property.lease.paymentDay }}</strong></div><div><span>Inicio</span><strong>{{ property.lease.startDate }}</strong></div><div><span>Vencimiento</span><strong>{{ property.lease.endDate }}</strong></div><div><span>Garantía</span><strong>{{ property.lease.guaranteeType }}</strong></div><div><span>Ajuste</span><strong>{{ property.lease.adjustment }}</strong></div></div><div class="data-table">{% for p in payments %}<div><span>{{ p.concept }}</span><span>{{ p.dueDate }}</span><strong>{{ money(p.amount,p.currency) }}</strong><span class="badge">{{ p.status }}</span></div>{% else %}<p class="muted">Sin movimientos.</p>{% endfor %}</div></section>
<section class="panel" id="impuestos"><h2>Impuestos / obligaciones</h2><div class="attention-list">{% for a in alerts %}{% if a.type == 'Impuesto' %}<div class="attention-item"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.notes }}</span></div><small>{{ a.statusText }} · {{ money(a.amount,a.currency) }}</small></div>{% endif %}{% endfor %}</div></section>
<section class="panel" id="documentos"><h2>Documentos</h2><div class="data-table">{% for d in documents %}<div><span>{{ d.type }}</span><strong>{{ d.title }}</strong><span>{{ d.dueDate or 'Sin vencimiento' }}</span><a href="{{ d.fileUrl }}">Abrir</a></div>{% else %}<p class="muted">Sin documentos.</p>{% endfor %}</div></section>
<section class="panel" id="reparaciones"><h2>Reparaciones</h2><div class="data-table">{% for c in complaints %}<div><span>#{{ c.number }}</span><strong>{{ c.title }}</strong><span>{{ c.status }}</span><a href="/admin/reclamos/{{ c.number }}">Abrir</a></div>{% else %}<p class="muted">Sin reclamos.</p>{% endfor %}</div></section>
<section class="panel" id="alertas"><h2>Alertas</h2><div class="attention-list">{% for a in alerts %}<div class="attention-item"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.type }}</span></div><small>{{ a.statusText }}</small></div>{% else %}<p class="muted">Sin alertas.</p>{% endfor %}</div></section>
<section class="panel" id="historial"><h2>Historial</h2><div class="timeline">{% for h in history %}<div><span>{{ h.at }}</span><strong>{{ h.action }}</strong><p>{{ h.detail }}</p><small>{{ h.actor }}</small></div>{% else %}<p class="muted">Sin historial.</p>{% endfor %}</div></section>
<section class="panel" id="qr"><h2>QR de la propiedad</h2><div class="qr-large"><img src="{{ qr }}"><p>{{ property.qrPublicPath }}</p></div></section><form method="post" action="/admin/propiedades/{{ property.code }}/eliminar" onsubmit="return confirm('¿Eliminar esta propiedad demo?')"><button class="btn btn-danger">Eliminar propiedad</button></form>{% endblock %}
