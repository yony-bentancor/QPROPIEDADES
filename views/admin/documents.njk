{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">ARCHIVO</span><h1>Documentos</h1><p class="muted">Contratos, comprobantes, impuestos, seguros y más.</p></div></div><section class="panel"><h2>Agregar documento</h2><form method="post" action="/admin/documentos/nuevo" class="form-grid"><label>Propiedad<select name="propertyCode">{% for p in properties %}<option value="{{ p.code }}">{{ p.address }} {{ p.unit }}</option>{% endfor %}</select></label><label>Tipo<select name="type">{% for t in documentTypes %}<option>{{ t }}</option>{% endfor %}</select></label><label>Título<input name="title" required></label><label>Fecha emisión<input type="date" name="issueDate"></label><label>Vencimiento<input type="date" name="dueDate"></label><label>URL del archivo<input name="fileUrl" placeholder="https://..."></label><label class="full">Notas<textarea name="notes"></textarea></label><div class="full"><button class="btn btn-primary">Agregar documento</button></div></form></section><div class="data-table">{% for d in documents %}<div><span>{{ d.propertyCode }}</span><span>{{ d.type }}</span><strong>{{ d.title }}</strong><span>{{ d.dueDate or 'Sin vencimiento' }}</span><a href="{{ d.fileUrl }}">Abrir</a><form method="post" action="/admin/documentos/{{ d.id }}/eliminar"><button class="btn btn-danger">Eliminar</button></form></div>{% endfor %}</div>{% endblock %}
