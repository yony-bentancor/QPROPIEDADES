{% extends 'layouts/admin.njk' %}
{% block content %}
<div class="page-head"><div><span class="eyebrow">PROPIEDAD</span><h1>{% if mode == 'create' %}Nueva propiedad{% else %}Editar propiedad{% endif %}</h1><p class="muted">Todos los campos principales son modificables.</p></div></div>
<form method="post" action="{% if mode == 'create' %}/admin/propiedades/nueva{% else %}/admin/propiedades/{{ property.code }}/editar{% endif %}" class="mega-form">
<section class="panel"><h2>Información general</h2><div class="form-grid"><label>Tipo<select name="type">{% for t in propertyTypes %}<option value="{{ t }}" {% if property.type == t %}selected{% endif %}>{{ t }}</option>{% endfor %}</select></label><label>Estado<input name="status" value="{{ property.status or 'Alquilada' }}"></label><label>Dirección<input name="address" value="{{ property.address }}" required></label><label>Unidad<input name="unit" value="{{ property.unit }}"></label><label>Barrio<input name="neighborhood" value="{{ property.neighborhood }}"></label><label>Ciudad<input name="city" value="{{ property.city }}"></label><label>Departamento<input name="department" value="{{ property.department }}"></label><label>Código postal<input name="postalCode" value="{{ property.postalCode }}"></label><label>Padrón<input name="cadastralNumber" value="{{ property.cadastralNumber }}"></label><label>Dormitorios<input type="number" name="bedrooms" value="{{ property.bedrooms or 0 }}"></label><label>Baños<input type="number" name="bathrooms" value="{{ property.bathrooms or 0 }}"></label><label>Área construida m²<input type="number" name="builtArea" value="{{ property.builtArea or 0 }}"></label><label>Área terreno m²<input type="number" name="landArea" value="{{ property.landArea or 0 }}"></label><label>Año<input type="number" name="yearBuilt" value="{{ property.yearBuilt or 0 }}"></label><label>Activa<select name="active"><option value="true" {% if property.active != false %}selected{% endif %}>Sí</option><option value="false" {% if property.active == false %}selected{% endif %}>No</option></select></label></div><label>Observaciones<textarea name="notes" rows="4">{{ property.notes }}</textarea></label></section>
<section class="panel"><h2>Ubicación</h2><div class="form-grid"><label>Google Maps URL<input name="mapUrl" value="{{ property.mapUrl }}"></label><label>Latitud<input name="latitude" value="{{ property.latitude }}"></label><label>Longitud<input name="longitude" value="{{ property.longitude }}"></label></div></section>
<section class="panel"><h2>Propietario</h2><p class="muted">El propietario se administra desde su ficha. Así los datos no se duplican en cada propiedad.</p><div class="form-grid"><label class="full">Propietario<select name="ownerId"><option value="">Sin propietario</option>{% for owner in owners %}<option value="{{ owner.id }}" {% if property.ownerId == owner.id %}selected{% endif %}>{{ owner.name }}{% if owner.document %} · {{ owner.document }}{% endif %}</option>{% endfor %}</select></label></div><a class="btn btn-light" href="/admin/propietarios/nuevo">+ Nuevo propietario</a></section>
<section class="panel"><h2>Inquilino</h2><div class="form-grid"><label>Nombre<input name="tenantName" value="{{ property.tenant.name }}"></label><label>Documento / RUT<input name="tenantDocument" value="{{ property.tenant.document }}"></label><label>Teléfono<input name="tenantPhone" value="{{ property.tenant.phone }}"></label><label>Email<input type="email" name="tenantEmail" value="{{ property.tenant.email }}"></label><label class="full">Contacto emergencia<input name="tenantEmergencyContact" value="{{ property.tenant.emergencyContact }}"></label><label class="full">Notas<textarea name="tenantNotes">{{ property.tenant.notes }}</textarea></label></div></section>
<section class="panel"><h2>Alquiler</h2><div class="form-grid"><label>Importe<input type="number" name="leaseAmount" value="{{ property.lease.amount or 0 }}"></label><label>Moneda<input name="leaseCurrency" value="{{ property.lease.currency or 'UYU' }}"></label><label>Día de pago<input type="number" name="paymentDay" value="{{ property.lease.paymentDay or 5 }}"></label><label>Inicio<input type="date" name="leaseStartDate" value="{{ property.lease.startDate }}"></label><label>Vencimiento<input type="date" name="leaseEndDate" value="{{ property.lease.endDate }}"></label><label>Garantía<input name="guaranteeType" value="{{ property.lease.guaranteeType }}"></label><label>Referencia garantía<input name="guaranteeRef" value="{{ property.lease.guaranteeRef }}"></label><label>Depósito<input type="number" name="depositAmount" value="{{ property.lease.depositAmount or 0 }}"></label><label>Ajuste<input name="adjustment" value="{{ property.lease.adjustment }}"></label><label>Estado<input name="leaseStatus" value="{{ property.lease.status }}"></label></div></section>
<section class="panel"><h2>Cuentas / servicios</h2><div class="form-grid"><label>OSE<input name="oseAccount" value="{{ property.utilities.oseAccount }}"></label><label>UTE<input name="uteAccount" value="{{ property.utilities.uteAccount }}"></label><label>ANTEL<input name="antelAccount" value="{{ property.utilities.antelAccount }}"></label><label>Gastos comunes<input name="commonExpensesAccount" value="{{ property.utilities.commonExpensesAccount }}"></label></div></section>
<div class="form-actions"><a href="/admin/propiedades" class="btn btn-light">Cancelar</a><button class="btn btn-primary">Guardar cambios</button></div>
</form>
{% endblock %}
