{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">ALERTAS</span><h1>Vencimientos</h1><p class="muted">Impuestos, contratos, alquileres, seguros y cualquier fecha importante.</p></div></div><section class="panel"><h2>Nueva alerta</h2><form method="post" action="/admin/vencimientos/nuevo" class="form-grid"><label>Propiedad<select name="propertyCode">{% for p in properties %}<option value="{{ p.code }}">{{ p.address }} {{ p.unit }}</option>{% endfor %}</select></label><label>Tipo<select name="type">{% for t in alertTypes %}<option>{{ t }}</option>{% endfor %}</select></label><label>Título<input name="title" required></label><label>Vencimiento<input type="date" name="dueDate" required></label><label>Importe<input type="number" name="amount"></label><label>Moneda<input name="currency" value="UYU"></label><label>Recurrencia<input name="recurrence" placeholder="Mensual, anual..."></label><label class="check"><input type="checkbox" name="recurring"> Es recurrente</label><label class="full">Notas<textarea name="notes"></textarea></label><div class="full"><button class="btn btn-primary">Crear alerta</button></div></form></section><div class="attention-list">{% for a in alerts %}<div class="attention-item alert-card"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.property.address }}{% if a.property.unit %} · {{ a.property.unit }}{% endif %} · {{ a.type }}</span><small>{{ a.dueDate }} · {{ a.statusText }}{% if a.amount %} · {{ money(a.amount,a.currency) }}{% endif %}</small></div><div class="actions"><form method="post" action="/admin/vencimientos/{{ a.id }}/toggle"><button class="btn btn-light">{% if a.paid %}Reabrir{% else %}Marcar cumplido{% endif %}</button></form><form method="post" action="/admin/vencimientos/{{ a.id }}/eliminar" onsubmit="return confirm('¿Eliminar alerta?')"><button class="btn btn-danger">Eliminar</button></form></div></div>{% endfor %}</div>{% endblock %}
