{% extends 'layouts/base.njk' %}{% block body %}<div class="report-shell"><div class="report-card"><a href="/" class="brand brand-dark"><span class="brand-mark">Q</span><span>QPROPIEDADES</span></a><span class="eyebrow">REPORTE DE MANTENIMIENTO</span><h1>¿Qué problema encontraste?</h1><div class="property-chip"><strong>{{ property.address }}{% if property.unit %} · {{ property.unit }}{% endif %}</strong><span>{{ property.type }} · {{ property.code }}</span></div>{% if error %}<div class="note note-danger" role="alert">{{ error }}</div>{% endif %}<form method="post" action="/r/{{ property.code }}/reclamar" enctype="multipart/form-data" class="stack-form" data-comprimir-fotos><label>Categoría<select name="category" required>{% for c in categories %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select></label><label>Título breve<input name="title" required placeholder="Ej: Pérdida debajo del lavatorio" value="{{ form.title if form }}"></label><label>Descripción<textarea name="description" rows="5" required>{{ form.description if form }}</textarea></label><label>Prioridad<select name="priority"><option value="medium">Normal</option><option value="high">Alta</option><option value="urgent">Urgente</option></select></label><label>Fotos o videos<input type="file" name="attachments" multiple accept="image/*,video/*"><small data-estado-fotos>Hasta 6 archivos, máximo 25 MB cada uno. Las fotos se achican solas antes de enviarse.</small></label><div class="tenant-preview"><strong>Contacto registrado</strong><span>{{ property.tenant.name }}</span><span>{{ property.tenant.phone }}</span></div><button class="btn btn-primary btn-large">Enviar reclamo</button></form></div></div><script src="/js/comprimir-fotos.js" defer></script>{% endblock %}
