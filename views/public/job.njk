{% extends 'layouts/base.njk' %}{% block body %}<div class="report-shell"><div class="report-card wide"><span class="eyebrow">QPROPIEDADES · FICHA DE TRABAJO</span><h1>Trabajo #{{ complaint.number }}</h1><p><span class="badge">{{ complaint.status }}</span> <span class="badge">{{ complaint.priority }}</span></p><section class="detail-section"><h2>Propiedad</h2><p><strong>{{ property.address }}{% if property.unit %} · {{ property.unit }}{% endif %}</strong></p><a href="{{ property.mapUrl }}" target="_blank">Abrir Google Maps ↗</a></section><section class="detail-section"><h2>Inquilino</h2><p>{{ property.tenant.name }} · <a href="tel:{{ property.tenant.phone }}">{{ property.tenant.phone }}</a></p></section><section class="detail-section"><h2>Problema</h2><p><strong>{{ complaint.title }}</strong></p><p>{{ complaint.description }}</p></section><section class="detail-section"><h2>Fotos / videos</h2><div class="media-grid">{% for a in complaint.attachments %}{% if a.kind == 'video' %}<video src="{{ a.url }}" controls></video>{% else %}<img src="{{ a.url }}" alt="{{ a.name }}">{% endif %}{% else %}<p class="muted">Sin archivos.</p>{% endfor %}</div></section></div></div>{% endblock %}
