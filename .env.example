PORT=3001
NODE_ENV=development
SESSION_SECRET=qpropiedades-cambiar-esta-clave
BASE_URL=http://localhost:3001
# Enlace "Estudio QR" del pie de página
ESTUDIOQR_URL=http://localhost:3000

# Modo demo (datos en memoria y usuarios demo)
DEMO_MODE=true

# MongoDB Atlas: con USE_MONGO=true los datos se guardan en la base y sobreviven a los reinicios.
# La primera vez se cargan los datos de muestra como punto de partida.
# Ejemplo: mongodb+srv://qpropiedades_user:CLAVE@cluster.xxxxx.mongodb.net/qpropiedades?retryWrites=true&w=majority
USE_MONGO=false
MONGO_URI=
# Protección: la semilla solo corre si esto se habilita explícitamente.
ALLOW_MONGO_SEED=false
# Mantener false. Salvaguarda adicional para no sembrar una base real.
ALLOW_NONTEST_SEED=false

# Cloudflare R2: adjuntos de reclamos (fotos y videos). Bucket PRIVADO.
# Sin estas variables los archivos quedan en /uploads (en Heroku se pierden al reiniciar).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=estudioqr-archivos
# Carpeta de este proyecto dentro del bucket
R2_PREFIX=qpropiedades/

# Con USE_MONGO=true no hay usuarios demo: entra solo este administrador.
QPROPIEDADES_ADMIN_EMAIL=admin@qcasa.uy
QPROPIEDADES_ADMIN_PASSWORD=
